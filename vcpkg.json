{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "hedgr",
    "version-semver": "0.0.1",
    "description": "Multi-instance ImGui/ImPlot client for OreStudio.",
    "dependencies": [
        {
            "name": "imgui",
            "features": [
                "glfw-binding",
                "opengl3-binding"
            ]
        },
        "implot",
        {
            "name": "glfw3",
            "features": [
                "wayland"
            ]
        },
        "glew",
        "openssl",
        "boost-log",
        "boost-scope-exit",
        "boost-iostreams",
        "boost-system",
        "boost-exception",
        "boost-uuid",
        "boost-crc",
        "boost-process",
        "boost-program-options",
        "magic-enum",
        {
            "name": "reflectcpp",
            "features": [
                "xml",
                "msgpack"
            ]
        },
        "jwt-cpp",
        "stb",
        {
            "name": "sqlite3",
            "features": [
                "math"
            ]
        },
        "sqlgen",
        "catch2"
    ]
}
