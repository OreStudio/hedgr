{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-configuration",
            "description": "Base class for common configuration options.",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/output/${presetName}",
            "cacheVariables": {
                "CMAKE_POSITION_INDEPENDENT_CODE": true,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": true,
                "CMAKE_CXX_EXTENSIONS": false,
                "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
                "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "ON",
                "CMAKE_FIND_USE_CMAKE_SYSTEM_PATH": "ON",
                "CMAKE_PREFIX_PATH": "",
                "VCPKG_INSTALL_OPTIONS": "--clean-after-build",
                "X_VCPKG_APPLOCAL_DEPS_INSTALL": true
            },
            "warnings": {
                "uninitialized": true,
                "dev": false,
                "deprecated": true,
                "systemVars": true
            },
            "errors": {
                "dev": false
            },
            "architecture": {
                "value": "unknown",
                "strategy": "external"
            }
        },
        {
            "name": "debug-build",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "description": "Setup CMake debug build."
        },
        {
            "name": "release-build",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "description": "Setup CMake release build."
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "description": "Setup the Clang C++ compiler."
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            },
            "description": "Setup the GCC C++ compiler."
        },
        {
            "name": "msvc-cl",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            },
            "description": "Setup the MSVC C++ compiler."
        },
        {
            "name": "linux-clang-debug",
            "displayName": "Linux Clang Debug",
            "inherits": [
                "base-configuration",
                "clang",
                "debug-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/linux-clang-debug"
            },
            "description": "Hedgr debug build for Linux Clang."
        },
        {
            "name": "linux-clang-release",
            "displayName": "Linux Clang Release",
            "inherits": [
                "base-configuration",
                "clang",
                "release-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/linux-clang-release"
            },
            "description": "Hedgr release build for Linux Clang."
        },
        {
            "name": "linux-clang-asan",
            "displayName": "Linux Clang ASan+UBSan",
            "inherits": [
                "linux-clang-debug"
            ],
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer"
            },
            "description": "Hedgr debug build for Linux Clang under AddressSanitizer and UndefinedBehaviorSanitizer."
        },
        {
            "name": "linux-clang-tsan",
            "displayName": "Linux Clang TSan",
            "inherits": [
                "linux-clang-debug"
            ],
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
            },
            "description": "Hedgr debug build for Linux Clang under ThreadSanitizer."
        },
        {
            "name": "linux-gcc-debug",
            "displayName": "Linux GCC Debug",
            "inherits": [
                "base-configuration",
                "gcc",
                "debug-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/linux-gcc-debug"
            },
            "description": "Hedgr debug build for Linux GCC."
        },
        {
            "name": "linux-gcc-release",
            "displayName": "Linux GCC Release",
            "inherits": [
                "base-configuration",
                "gcc",
                "release-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/linux-gcc-release"
            },
            "description": "Hedgr release build for Linux GCC."
        },
        {
            "name": "windows-arch-x64",
            "hidden": true,
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "description": "Base configuration for Windows 64-bit"
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows x64",
            "hidden": true,
            "inherits": [
                "windows-arch-x64",
                "msvc-cl"
            ],
            "cacheVariables": {
                "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            },
            "description": "Setup the MSVC C++ compiler for Windows."
        },
        {
            "name": "windows-msvc-debug",
            "displayName": "Windows x64 Debug",
            "inherits": [
                "base-configuration",
                "windows-msvc",
                "debug-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/windows-msvc-debug"
            },
            "description": "Hedgr debug build for Windows MSVC."
        },
        {
            "name": "windows-msvc-release",
            "displayName": "Windows x64 Release",
            "inherits": [
                "base-configuration",
                "windows-msvc",
                "release-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/windows-msvc-release"
            },
            "description": "Hedgr release build for Windows MSVC."
        },
        {
            "name": "macos-clang-debug",
            "displayName": "Mac OSX Debug",
            "inherits": [
                "base-configuration",
                "debug-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/macos-clang-debug"
            },
            "description": "Hedgr debug build for MacOSX Clang."
        },
        {
            "name": "macos-clang-release",
            "displayName": "Mac OSX Release",
            "inherits": [
                "base-configuration",
                "release-build"
            ],
            "cacheVariables": {
                "ORES_BUILD_DIR": "${sourceDir}/external/OreStudio/build/output/macos-clang-release"
            },
            "description": "Hedgr release build for MacOSX Clang."
        }
    ],
    "buildPresets": [
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug"
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release"
        },
        {
            "name": "linux-clang-asan",
            "configurePreset": "linux-clang-asan"
        },
        {
            "name": "linux-clang-tsan",
            "configurePreset": "linux-clang-tsan"
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug"
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release"
        },
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug"
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release"
        },
        {
            "name": "macos-clang-debug",
            "configurePreset": "macos-clang-debug"
        },
        {
            "name": "macos-clang-release",
            "configurePreset": "macos-clang-release"
        }
    ],
    "testPresets": [
        {
            "name": "test-default",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "linux-clang-debug",
            "configurePreset": "linux-clang-debug",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "linux-clang-release",
            "configurePreset": "linux-clang-release",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "linux-clang-asan",
            "configurePreset": "linux-clang-asan",
            "inherits": [
                "test-default"
            ],
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        },
        {
            "name": "linux-clang-tsan",
            "configurePreset": "linux-clang-tsan",
            "inherits": [
                "test-default"
            ],
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
            }
        },
        {
            "name": "linux-gcc-debug",
            "configurePreset": "linux-gcc-debug",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "linux-gcc-release",
            "configurePreset": "linux-gcc-release",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "windows-msvc-debug",
            "configurePreset": "windows-msvc-debug",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "windows-msvc-release",
            "configurePreset": "windows-msvc-release",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "macos-clang-debug",
            "configurePreset": "macos-clang-debug",
            "inherits": [
                "test-default"
            ]
        },
        {
            "name": "macos-clang-release",
            "configurePreset": "macos-clang-release",
            "inherits": [
                "test-default"
            ]
        }
    ],
    "workflowPresets": [
        {
            "description": "Developer workflow without installation",
            "name": "linux-clang-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-clang-debug"
                },
                {
                    "type": "build",
                    "name": "linux-clang-debug"
                },
                {
                    "type": "test",
                    "name": "linux-clang-debug"
                }
            ]
        },
        {
            "description": "Developer workflow without installation",
            "name": "linux-clang-release",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-clang-release"
                },
                {
                    "type": "build",
                    "name": "linux-clang-release"
                },
                {
                    "type": "test",
                    "name": "linux-clang-release"
                }
            ]
        },
        {
            "description": "Developer workflow without installation",
            "name": "linux-gcc-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-gcc-debug"
                },
                {
                    "type": "build",
                    "name": "linux-gcc-debug"
                },
                {
                    "type": "test",
                    "name": "linux-gcc-debug"
                }
            ]
        },
        {
            "description": "Developer workflow without installation",
            "name": "linux-gcc-release",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-gcc-release"
                },
                {
                    "type": "build",
                    "name": "linux-gcc-release"
                },
                {
                    "type": "test",
                    "name": "linux-gcc-release"
                }
            ]
        }
    ]
}
